#!/bin/sh
# Runs the full test suite before every push, including the SHA-256 check of data/raw/.
# The push is blocked if any test fails.
# Install once per computer:  git config core.hooksPath scripts/hooks

cd "$(git rev-parse --show-toplevel)" || exit 1

PYTHON=.venv/bin/python
[ -x "$PYTHON" ] || PYTHON=python3

echo "pre-push: running tests (includes raw-data checksum check)..."
if ! "$PYTHON" -m pytest -q; then
    echo ""
    echo "PUSH BLOCKED: tests failed (see above). Fix them, then push again."
    exit 1
fi
